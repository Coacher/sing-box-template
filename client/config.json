{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "dot-google-direct",
        "type": "tls",
        "server": "8.8.8.8",
        "tls": {
          "enabled": true,
          "server_name": "dns.google"
        }
      },
      {
        "tag": "dot-yandex-direct",
        "type": "tls",
        "server": "77.88.8.8",
        "tls": {
          "enabled": true,
          "server_name": "common.dot.dns.yandex.net"
        }
      },
      {
        "tag": "dot-google-tunnel",
        "type": "tls",
        "server": "8.8.8.8",
        "tls": {
          "enabled": true,
          "server_name": "dns.google"
        },
        "detour": "tunnel-auto"
      }
    ],
    "rules": [
      {
        "domain": ["use-application-dns.net"],
        "action": "predefined",
        "rcode": "NXDOMAIN"
      },
      {
        "rule_set": ["geosite-reddit"],
        "action": "route",
        "server": "dot-google-direct"
      },
      {
        "rule_set": ["geosite-habr"],
        "action": "route",
        "server": "dot-google-tunnel"
      },
      {
        "rule_set": [
          "domain-ru",
          "geosite-ru",
          "geosite-ru-inside"
        ],
        "action": "route",
        "server": "dot-yandex-direct"
      }
    ],
    "final": "dot-google-tunnel",
    "strategy": "ipv4_only",
    "reverse_mapping": true
  },
  "http_clients": [
    {
      "tag": "rule-set-download",
      "detour": "tunnel-auto"
    }
  ],
  "inbounds": [
    {
      "tag": "tun-in",
      "type": "tun",
      "address": ["10.10.10.1/30", "fd00::1/126"],
      "auto_route": true,
      "auto_redirect": true,
      "strict_route": true,
      "route_exclude_address": ["SERVER_IP/32"]
    }
  ],
  "outbounds": [
    {
      "tag": "vless-vision-out",
      "type": "vless",
      "server": "SERVER_IP",
      "server_port": 443,
      "tls": {
        "enabled": true,
        "server_name": "store.steampowered.com",
        "min_version": "1.2",
        "reality": {
          "enabled": true,
          "public_key": "REALITY_PUBLIC_KEY",
          "short_id": "REALITY_SHORT_ID"
        },
        "utls": {
          "enabled": true,
          "fingerprint": "edge"
        }
      },
      "multiplex": {
        "enabled": false,
        "padding": false
      },
      "uuid": "VLESS_USER_UUID_1",
      "flow": "xtls-rprx-vision"
    },
    {
      "tag": "vless-mux-out",
      "type": "vless",
      "server": "SERVER_IP",
      "server_port": 443,
      "tls": {
        "enabled": true,
        "server_name": "store.steampowered.com",
        "min_version": "1.2",
        "reality": {
          "enabled": true,
          "public_key": "REALITY_PUBLIC_KEY",
          "short_id": "REALITY_SHORT_ID"
        },
        "utls": {
          "enabled": true,
          "fingerprint": "edge"
        }
      },
      "multiplex": {
        "enabled": true,
        "padding": true,
        "max_connections": 4
      },
      "uuid": "VLESS_USER_UUID_2",
      "flow": ""
    },
    {
      "tag": "hy2-salamander-brutal-out",
      "type": "hysteria2",
      "server": "SERVER_IP",
      "server_ports": ["40000:44999"],
      "hop_interval": "30s",
      "hop_interval_max": "60s",
      "down_mbps": 100,
      "up_mbps": 100,
      "obfs": {
        "type": "salamander",
        "password": "SALAMANDER_OBFS_PASSWORD"
      },
      "tls": {
        "enabled": true,
        "server_name": "cloud.google.com",
        "min_version": "1.3",
        "certificate_public_key_sha256": ["HYSTERIA2_CERT_HASH"]
      },
      "password": "HYSTERIA2_USER_PASSWORD"
    },
    {
      "tag": "hy2-salamander-bbr-out",
      "type": "hysteria2",
      "server": "SERVER_IP",
      "server_port": 443,
      "obfs": {
        "type": "salamander",
        "password": "SALAMANDER_OBFS_PASSWORD"
      },
      "tls": {
        "enabled": true,
        "server_name": "cloud.google.com",
        "min_version": "1.3",
        "certificate_public_key_sha256": ["HYSTERIA2_CERT_HASH"]
      },
      "password": "HYSTERIA2_USER_PASSWORD"
    },
    {
      "tag": "hy2-gecko-brutal-out",
      "type": "hysteria2",
      "server": "SERVER_IP",
      "server_ports": ["45000:49999"],
      "hop_interval": "30s",
      "hop_interval_max": "60s",
      "down_mbps": 100,
      "up_mbps": 100,
      "obfs": {
        "type": "gecko",
        "password": "GECKO_OBFS_PASSWORD"
      },
      "tls": {
        "enabled": true,
        "server_name": "cloud.google.com",
        "min_version": "1.3",
        "certificate_public_key_sha256": ["HYSTERIA2_CERT_HASH"]
      },
      "password": "HYSTERIA2_USER_PASSWORD"
    },
    {
      "tag": "hy2-gecko-bbr-out",
      "type": "hysteria2",
      "server": "SERVER_IP",
      "server_port": 8443,
      "obfs": {
        "type": "gecko",
        "password": "GECKO_OBFS_PASSWORD"
      },
      "tls": {
        "enabled": true,
        "server_name": "cloud.google.com",
        "min_version": "1.3",
        "certificate_public_key_sha256": ["HYSTERIA2_CERT_HASH"]
      },
      "password": "HYSTERIA2_USER_PASSWORD"
    },
    {
      "tag": "tunnel-auto",
      "type": "urltest",
      "outbounds": [
        "vless-vision-out",
        "vless-mux-out",
        "hy2-salamander-brutal-out",
        "hy2-salamander-bbr-out",
        "hy2-gecko-brutal-out",
        "hy2-gecko-bbr-out"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "1m",
      "tolerance": 150,
      "interrupt_exist_connections": true
    },
    {
      "tag": "direct",
      "type": "direct"
    }
  ],
  "route": {
    "final": "tunnel-auto",
    "auto_detect_interface": true,
    "default_http_client": "rule-set-download",
    "default_domain_resolver": "dot-google-tunnel",
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": ["geosite-reddit"],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": ["geosite-habr"],
        "action": "route",
        "outbound": "tunnel-auto"
      },
      {
        "rule_set": [
          "geoip-ru",
          "geoip-yandex"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "domain-ru",
          "geosite-ru",
          "geosite-ru-inside"
        ],
        "action": "route",
        "outbound": "direct"
      }
    ],
    "rule_set": [
      {
        "tag": "domain-ru",
        "rules": [
          {
            "domain_suffix": [
              ".ru",
              ".su",
              ".рф",
              ".xn--p1ai"
            ]
          }
        ]
      },
      {
        "tag": "geoip-ru",
        "type": "remote",
        "url": "https://raw.githubusercontent.com/runetfreedom/russia-v2ray-rules-dat/release/sing-box/rule-set-geoip/geoip-ru.srs"
      },
      {
        "tag": "geoip-yandex",
        "type": "remote",
        "url": "https://raw.githubusercontent.com/runetfreedom/russia-v2ray-rules-dat/release/sing-box/rule-set-geoip/geoip-yandex.srs"
      },
      {
        "tag": "geosite-ru",
        "type": "remote",
        "url": "https://raw.githubusercontent.com/runetfreedom/russia-v2ray-rules-dat/release/sing-box/rule-set-geosite/geosite-category-ru.srs"
      },
      {
        "tag": "geosite-ru-inside",
        "type": "remote",
        "url": "https://raw.githubusercontent.com/runetfreedom/russia-v2ray-rules-dat/release/sing-box/rule-set-geosite/geosite-ru-available-only-inside.srs"
      },
      {
        "tag": "geosite-habr",
        "type": "remote",
        "url": "https://raw.githubusercontent.com/runetfreedom/russia-v2ray-rules-dat/release/sing-box/rule-set-geosite/geosite-habr.srs"
      },
      {
        "tag": "geosite-reddit",
        "type": "remote",
        "url": "https://raw.githubusercontent.com/runetfreedom/russia-v2ray-rules-dat/release/sing-box/rule-set-geosite/geosite-reddit.srs"
      }
    ]
  },
  "experimental": {
    "cache_file": {
      "enabled": true
    }
  }
}
